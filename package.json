{
  "name": "vm-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Portfólio imersivo da VM Studio (Vitor Milagres).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p .",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "npm run build && node --test --test-concurrency=1 \"tests/e2e/*.e2e.js\"",
    "test": "npm run test:unit && npm run test:e2e",
    "check": "npm run lint && npm run typecheck && npm run test",
    "graph": "node scripts/graph.mjs"
  },
  "devDependencies": {
    "eslint": "^10.1.0",
    "playwright": "^1.56.1",
    "typescript": "^6.0.2"
  }
}
